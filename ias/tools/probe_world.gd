extends SceneTree
## 抽查全球代表点的地貌分类，烘焙前先看结果对不对

const NAMES := ["平原", "丘陵", "山地", "高原", "盆地", "河谷", "荒漠", "草原", "森林",
	"湿地", "冰雪", "水", "喀斯特", "雅丹", "黄土", "沙丘", "冰川谷", "三角洲",
	"花岗岩山地", "喀斯特山地", "黄土山地", "火山山地", "冰蚀山地", "红壤丘陵",
	"黄土丘陵", "丹霞丘陵", "沙质荒漠", "砾质荒漠", "盐碱"]

const PTS := [
	["撒哈拉", 10.0, 23.0], ["阿拉伯", 45.0, 22.0], ["澳洲中部", 133.0, -25.0],
	["阿塔卡马", -69.0, -23.0], ["戈壁", 105.0, 42.0], ["塔克拉玛干", 83.0, 39.0],
	["印度德干", 78.0, 18.0], ["孟加拉", 90.0, 23.0], ["中南半岛", 101.0, 15.0],
	["中国华北", 116.0, 36.0], ["长江中游", 113.0, 30.0], ["华南", 113.0, 23.0],
	["四川盆地", 105.0, 30.0], ["黄土高原", 109.0, 36.0], ["青藏", 88.0, 33.0],
	["美国东南", -85.0, 33.0], ["美国中西部", -100.0, 40.0],
	["巴西东南", -46.0, -22.0], ["亚马逊", -62.0, -5.0],
	["澳洲东岸", 151.0, -30.0], ["非洲东南", 32.0, -25.0],
	["刚果", 20.0, -2.0], ["西伯利亚", 105.0, 62.0], ["哈萨克", 68.0, 47.0],
	["巴塔哥尼亚", -70.0, -45.0], ["欧洲平原", 15.0, 50.0],
]


func _init() -> void:
	var tg = load("res://scripts/terrain_gen.gd")
	tg.ensure_loaded()
	print("地点              经度    纬度   高程   分类")
	for p in PTS:
		var lon: float = p[1]
		var lat: float = p[2]
		var h: float = tg.dem_at(lon, lat)
		var k: int = tg.landform_kind(lon, lat, h)
		print("%-14s %7.1f %7.1f %6.0f   %s" % [p[0], lon, lat, h, NAMES[k]])
	quit()

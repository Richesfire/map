extends SceneTree

const NAMES := ["平原", "丘陵", "山地", "高原", "盆地", "河谷", "荒漠", "草原", "森林",
	"湿地", "冰雪", "水", "喀斯特", "雅丹", "黄土", "沙丘", "冰川谷", "三角洲",
	"花岗岩山地", "喀斯特山地", "黄土山地", "火山山地", "冰蚀山地", "红壤丘陵",
	"黄土丘陵", "丹霞丘陵", "沙质荒漠", "砾质荒漠", "盐碱"]

const PTS := [
	["云南", 100.0, 24.0], ["广西", 108.0, 24.0], ["贵州", 106.0, 27.0],
	["恒河平原", 82.0, 25.0], ["德干", 78.0, 18.0], ["巴西中部", -50.0, -15.0],
	["巴西东南", -46.0, -22.0], ["河南", 114.0, 34.0], ["江汉", 112.0, 30.0],
	["珠江三角洲", 113.0, 23.0], ["内蒙古", 112.0, 42.0], ["塔里木", 84.0, 39.0],
]


func _init() -> void:
	var tg = load("res://scripts/terrain_gen.gd")
	tg.ensure_loaded()
	for p in PTS:
		var lon: float = p[1]
		var lat: float = p[2]
		var h: float = tg.dem_at(lon, lat)
		print("%-10s %6.1f %6.1f h=%5.0f  %s" % [p[0], lon, lat, h,
				NAMES[tg.landform_kind(lon, lat, h)]])
	quit()

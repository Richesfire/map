# 行尾与二进制文件：仓库和检出统一 LF（Windows 的 .bat/.ps1 例外，见下）
* text=auto eol=lf

# Windows 批处理/脚本必须 CRLF：cmd 解析 ( ) 块和 goto 标签时对 LF 不稳
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：别让 git 当文本 diff / 合并
*.png binary
*.jpg binary
*.jpeg binary
*.glb binary
*.blend binary
*.bin binary
*.zip binary
*.docx binary
*.xlsx binary
*.ttf binary
*.otf binary
